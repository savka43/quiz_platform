POSTGRES_USER=quiz
POSTGRES_PASSWORD=quiz_password
POSTGRES_DB=quiz_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

AUTH_JWT__ALGORITHM=RS256
AUTH_JWT__ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_JWT__REFRESH_TOKEN_EXPIRE_DAYS=30
# Optional absolute paths; defaults point to backend/api_v1/auth/certs/.
# AUTH_JWT__PRIVATE_KEY_PATH=/absolute/path/jwt-private.pem
# AUTH_JWT__PUBLIC_KEY_PATH=/absolute/path/jwt-public.pem
